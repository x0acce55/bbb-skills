#!/bin/sh
# fable — one-off Fable 5 question from anywhere (local-model sessions, scripts),
# billed to Claude Platform on AWS. Same Bearer-only wrapper as claude-paid
# (see that file for why apiKeyHelper cannot be used with this endpoint).
#   usage: fable "why is the sky blue"
ANTHROPIC_AUTH_TOKEN="$(gcloud secrets versions access latest --secret=anthropic-api-key --project=secops-opintel)" \
ANTHROPIC_BASE_URL="https://aws-external-anthropic.us-east-1.api.aws" \
ANTHROPIC_CUSTOM_HEADERS="anthropic-workspace-id: wrkspc_012NWagiqkWqfBCDGN7WAqUC" \
  exec claude -p --model claude-fable-5 "$@"
